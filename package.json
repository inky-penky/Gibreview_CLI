{
  "name": "gibreview",
  "version": "0.1.0",
  "description": "Review Gibwork bounty submissions: automated checks, a ranked shortlist, a reason for every decision, and payouts or a website checklist. Includes a QA preset for crowdsourced manual testing.",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/review/cli.js",
    "mcp": "node dist/mcp.js",
    "demo": "bash examples/demo.sh",
    "demo:review": "bash examples/review-demo.sh",
    "demo:agent": "node examples/mcp-review-demo.mjs",
    "prepare": "tsc"
  },
  "keywords": [
    "gibwork",
    "bounty",
    "review",
    "qa",
    "testing",
    "mcp",
    "solana",
    "cli"
  ],
  "author": "Ahmad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inky-penky/Gibreview_CLI.git"
  },
  "homepage": "https://github.com/inky-penky/Gibreview_CLI#readme",
  "bugs": {
    "url": "https://github.com/inky-penky/Gibreview_CLI/issues"
  },
  "dependencies": {
    "@gibwork/sdk": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "node-html-parser": "^9.0.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "bin": {
    "gibreview": "dist/review/cli.js",
    "gibreview-mcp": "dist/mcp.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/test",
    "examples",
    "README.md"
  ]
}
