# Copy to .env or .env.local (both gitignored; .env.local wins). Never commit real keys.
# Solana wallet that funds bounties and pays testers.
# A private key: base58, or a JSON byte array like [12,34,...]. Not a 12/24-word recovery phrase.
SOLANA_PRIVATE_KEY=

# stage (default) or production
GIBWORK_ENV=stage

# Set to 1 to run everything against the offline simulator instead of Gibwork
GIBREVIEW_MOCK=0

# MCP server only
# GIBREVIEW_DIR=/absolute/path/to/project/.gibreview/qa
# GIBREVIEW_MCP_ALLOW_PRODUCTION=1   # let agents spend on production (they still need the confirm code)
# GIBREVIEW_MCP_MAX_BUDGET=50        # most escrow one run may fund through the MCP server

# Optional: AI writer for "gibreview qa generate"
# ANTHROPIC_API_KEY=
# GIBREVIEW_AI_MODEL=claude-sonnet-5-5
