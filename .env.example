# Solana wallet that funds bounties and pays testers.
# base58 secret key, or a JSON byte array like [12,34,...]. Never commit your real .env.
SOLANA_PRIVATE_KEY=

# stage (default) or production
GIBWORK_ENV=stage

# Set to 1 to run everything against the offline simulator instead of Gibwork
BUGBASH_MOCK=0

# MCP server only
# BUGBASH_DIR=/absolute/path/to/project/.bugbash
# BUGBASH_MCP_ALLOW_PRODUCTION=1   # let agents spend on production after confirm=true
