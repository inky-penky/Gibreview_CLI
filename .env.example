# Copy to .env or .env.local (both gitignored; .env.local wins). Never commit real keys.
# Solana wallet that funds bounties and pays testers.
# A private key: base58, or a JSON byte array like [12,34,...]. Not a 12/24-word recovery phrase.
SOLANA_PRIVATE_KEY=

# stage (default) or production
GIBWORK_ENV=stage

# Set to 1 to run everything against the offline simulator instead of Gibwork
BUGBASH_MOCK=0

# MCP server only
# BUGBASH_DIR=/absolute/path/to/project/.bugbash
# BUGBASH_MCP_ALLOW_PRODUCTION=1   # let agents spend on production (they still need the confirm code)
# BUGBASH_MCP_MAX_BUDGET=50        # most escrow one run may fund through the MCP server

# Optional: AI writer for "bugbash generate"
# ANTHROPIC_API_KEY=
# BUGBASH_AI_MODEL=claude-sonnet-5-5
